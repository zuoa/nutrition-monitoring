FLASK_ENV=development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nutrition_db
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition_dev
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
SECRET_KEY=dev-secret-key-change-in-production
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
SYSTEM_RUNTIME_NOTIFICATION_ENABLED=false
SYSTEM_RUNTIME_NOTIFICATION_WEBHOOK_URL=
SYSTEM_RUNTIME_NOTIFICATION_WEBHOOK_PREFIX=[营养监测系统运行]
SYSTEM_RUNTIME_NOTIFICATION_TIME=08:10
NUTRITION_ALERT_NOTIFICATION_ENABLED=true
WEEKLY_REPORT_DAY_OF_WEEK=sunday
WEEKLY_REPORT_TIME=08:00
# 学生同步：dingtalk 或 rest_student_list。API Key 只放部署环境，不要提交。
STUDENT_SYNC_PROVIDER=dingtalk
STUDENT_SYNC_REST_URL=
STUDENT_SYNC_REST_API_KEY=
STUDENT_SYNC_REST_HTTP_METHOD=GET
STUDENT_SYNC_REST_TIMEOUT_SECONDS=15
STUDENT_SYNC_SCHOOL_NAME=默认学校
STUDENT_SYNC_CAMPUS_NAME=默认校区
STUDENT_SYNC_STAGE_NAME=默认学段
STUDENT_SYNC_DEACTIVATE_MISSING=false
QWEN_API_KEY=

# OpenAI-compatible API (for dish nutrition analysis, default to DeepSeek)
# Supports: DeepSeek, OpenAI, or any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Video source: "nvr" (default) or "hikvision_camera"
VIDEO_SOURCE_MODE=nvr
# Required when VIDEO_SOURCE_MODE=hikvision_camera
# JSON: {"1": {"host": "192.168.1.101", "port": 80, "username": "admin", "password": "xxx"}}
HIKVISION_CAMERAS={}

# Durable, bounded distributed video pipeline
VIDEO_DOWNLOAD_MAX_IN_FLIGHT=4
VIDEO_EXTRACT_MAX_IN_FLIGHT=4
VIDEO_RECORDING_DISPATCH_LEASE_SECONDS=300
VIDEO_RECORDING_QUEUED_LEASE_SECONDS=21600
VIDEO_RECORDING_HEARTBEAT_LEASE_SECONDS=1800
VIDEO_RECORDING_DISPATCH_MAX_ATTEMPTS=20
VIDEO_RECORDING_TASK_SOFT_TIME_LIMIT=10800
VIDEO_RECORDING_TASK_TIME_LIMIT=11400
VIDEO_EXTRACT_MAX_RUNTIME_SECONDS=7200
VIDEO_EXTRACT_CPU_THREADS_PER_JOB=2
LEGACY_ANALYSIS_MAX_WIDTH=960
LEGACY_ANALYSIS_MAX_HEIGHT=540
