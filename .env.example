# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your_secure_password_here
# Optional explicit DB parts; normally only password needs changing
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nutrition_db
POSTGRES_USER=nutrition
REDIS_PASSWORD=your_secure_redis_password_here

# ─── Zhengyuan One-Card PLUS Database Sync ───────────────────────────────────
# 正元一卡通 PLUS SQL Server，只配置在部署环境；不要提交真实账号密码。
ZTK_DB_HOST=
ZTK_DB_PORT=1433
ZTK_DB_NAME=ZYTK40_PLUS
ZTK_DB_USER=
ZTK_DB_PASSWORD=
ZTK_PAYMENT_BOOKS_TABLE=dbo.view_ac_paymentbooks
ZTK_ACCOUNTS_TABLE=dbo.ac_dict_Accounts
ZTK_ACCOUNTS_TABLE=ac_dict_Accounts
ZTK_SYNC_ENABLED=false
ZTK_SYNC_INTERVAL_MINUTES=5
ZTK_SYNC_LOOKBACK_MINUTES=5
ZTK_SYNC_PAGE_SIZE=1000
# 每次同步从本地最大时间戳开始，单次最多拉取的行数；不够时下次 beat 自动续拉
ZTK_SYNC_MAX_ROWS_PER_RUN=50000

# ─── Application ─────────────────────────────────────────────────────────────
SECRET_KEY=your_very_long_random_secret_key_here
FLASK_ENV=production

# ─── DingTalk ─────────────────────────────────────────────────────────────────
DINGTALK_APP_KEY=dingxxxxxxxxxxxxxxxxx
DINGTALK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DINGTALK_AGENT_ID=1234567890
DINGTALK_CORP_ID=ding_corp_id_here

# ─── Qwen3-VL AI ──────────────────────────────────────────────────────────────
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
QWEN_MODEL=qwen-vl-max
QWEN_MAX_QPS=10

# ─── OpenAI-compatible API (for dish nutrition analysis, default to DeepSeek) ─
# Supports: DeepSeek, OpenAI, or any OpenAI-compatible API
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ─── Video Sources ────────────────────────────────────────────────────────────
# 视频源（NVR / 海康摄像头）请在后台管理页创建并激活，不再通过环境变量配置。

# ─── Video Analysis ───────────────────────────────────────────────────────────
# DIFF_THRESHOLD: 帧差分阈值，超过此值认为有运动 (默认30)
# PLATE_PIXEL_THRESHOLD: 与背景相比的像素变化阈值，用于判断ROI中是否有餐盘 (默认5000)
# 如果ROI较大或餐盘较大，可适当调高；如果误检/漏检严重，可适当调整
# DIFF_THRESHOLD=30
# PLATE_PIXEL_THRESHOLD=5000

# ENABLE_PLATE_FILTER: 是否启用后置餐盘检测过滤 (默认true)
# 视频分析后会再次检测图片中是否有餐盘，过滤掉无餐盘的图片
# ENABLE_PLATE_FILTER=true

# VIDEO_ANALYSIS_MAX_CONCURRENCY: 下载与抽帧流水线的最大抽帧并发数 (默认3)
# VIDEO_ANALYSIS_MAX_CONCURRENCY=3
# VIDEO_ANALYSIS_MAX_PENDING: 最大已下载待抽帧数；0 表示自动设为并发数的 2 倍。
# VIDEO_ANALYSIS_MAX_PENDING=0
# VIDEO_DISTRIBUTED_PIPELINE=true
# VIDEO_RECORDING_JOB_STALE_SECONDS=7200
# VIDEO_DOWNLOAD_TASK_SOFT_TIME_LIMIT=1800
# VIDEO_DOWNLOAD_TASK_TIME_LIMIT=2100
# VIDEO_RECORDING_TASK_SOFT_TIME_LIMIT=5400
# VIDEO_RECORDING_TASK_TIME_LIMIT=5700
# EVENT_SCAN_FPS: 抽帧分析扫描帧率 (默认12，建议保持在已验证的 12-15 范围)
# EVENT_SCAN_FPS=12.0
# LEGACY_ANALYSIS_MAX_WIDTH/HEIGHT: 分析用缩放上限，默认 720p。
# LEGACY_ANALYSIS_MAX_WIDTH=1280
# LEGACY_ANALYSIS_MAX_HEIGHT=720
# 单段录像抽帧使用独立子进程；无新进度超过 15 分钟会终止当前尝试并进入恢复策略。
# VIDEO_EXTRACT_USE_SUBPROCESS=true
# VIDEO_EXTRACT_PROGRESS_STALL_SECONDS=900
# 单段主分析超时后直接进入兜底，避免重复全量解码。
# VIDEO_EXTRACT_MAX_RUNTIME_SECONDS=1800
# VIDEO_EXTRACT_CPU_THREADS_PER_JOB=1
# VIDEO_EXTRACT_DEGRADE_BEFORE_SYNC_TIMEOUT_SECONDS=1800
# 健康心跳监控 FFmpeg 的进度；超时表示长时间无进度，不是绝对运行时长。
# VIDEO_EXTRACT_FFMPEG_TIMEOUT_SECONDS=1800
# VIDEO_EXTRACT_FALLBACK_INTERVAL_SECONDS=30
# VIDEO_EXTRACT_FALLBACK_MAX_FRAMES=500
# VIDEO_ANALYSIS_MAX_EVENT_CANDIDATES=120
# VIDEO_ANALYSIS_MAX_SCAN_HISTORY=10000
# VIDEO_ANALYSIS_QUALITY_MAX_DIMENSION=320
# 事件检测仍使用 EVENT_SCAN_FPS；只将昂贵的清晰度/FFT 候选帧打分限制为每秒 4 帧。
# VIDEO_ANALYSIS_CANDIDATE_FPS=4.0
# 解码在容器声称总帧数的 50% 前提前结束时，视为损坏录像并进入修复。
# VIDEO_EXTRACT_MIN_DECODE_COMPLETION_RATIO=0.5
# 每段录像完成后会立即提交识别；以下限制只约束整天录像同步协调任务。
# VIDEO_SYNC_TASK_SOFT_TIME_LIMIT=43200
# VIDEO_SYNC_TASK_TIME_LIMIT=43800
# CELERY_VISIBILITY_TIMEOUT=86400

# ─── Matching（消费记录与视频画面匹配）─────────────────────────────────────
# TIME_OFFSET_TOLERANCE: 匹配接受的时间容差（秒，默认1）。
# TIME_OFFSET_TOLERANCE=1
# PRICE_TOLERANCE: 匹配接受的金额差（元，默认0.5）。
# PRICE_TOLERANCE=0.5
# TIME_OFFSET_CALIBRATION: 消费-视频时间偏移校正（秒，浮点，默认0）。
# 该值会叠加到消费记录 transaction_time 上后再与视频 captured_at 匹配，
# 用于校正一卡通与摄像头两套时钟之间的系统性偏差。
# 正值表示消费刷卡时间整体早于视频画面（需后移对齐），负值相反。可在「系统设置」修改。
# TIME_OFFSET_CALIBRATION=0

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://nutrition.school.edu.cn

# ─── Internal Inference Services ──────────────────────────────────────────────
INFERENCE_API_TOKEN=change_me_internal_token
INFERENCE_API_TIMEOUT=60
# 单图识别任务软/硬超时。HTTP 请求会更早在 INFERENCE_API_TIMEOUT 失败并重试。
# RECOGNITION_TASK_SOFT_TIME_LIMIT=150
# RECOGNITION_TASK_TIME_LIMIT=180
# 图片完成原子认领后，发布到 Redis 的最长允许时间；超时未发布会自动恢复。
# RECOGNITION_DISPATCH_LEASE_SECONDS=300
# Redis 已确认接收后，图片最长允许保持 queued 的时间；超时会安全地再次投递。
# RECOGNITION_QUEUED_LEASE_SECONDS=21600
# 单 GPU 默认从 2 开始压测；不要直接增加 inference Gunicorn worker 数。
# RECOGNITION_WORKER_CONCURRENCY=2
INFERENCE_CONTROL_TIMEOUT=3
DETECTOR_API_BASE_URL=http://detector-api:5000
RETRIEVAL_API_BASE_URL=http://retrieval-api:5000
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
YOLO_MAX_REGIONS=6
LOCAL_RERANK_TOPN=3
YOLO_MODEL_PATH=/models/yolo/best.pt
# 宿主机推理数据根目录；模型实际保存在该目录的 retrieval/models 下。
INFERENCE_DATA_DIR=./inference-data
INFERENCE_LOCAL_MODEL_STORAGE_PATH=/data/models
INFERENCE_LOCAL_EMBEDDING_INDEX_DIR=/data/index
LOCAL_EMBEDDING_BATCH_SIZE=8
# 限制视觉 token 峰值；8GB GPU 推荐不高于 786432。
LOCAL_EMBEDDING_MAX_PIXELS=786432
# 可选 auto、bf16、fp16、fp32、int8；8GB GPU 推荐 int8。
LOCAL_QWEN3_VL_EMBEDDING_PRECISION=auto
LOCAL_QWEN3_VL_RERANKER_PRECISION=auto
# 8GB GPU 无法同时常驻 2B embedding 和 2B reranker 模型时设为 false。
LOCAL_RERANK_ENABLED=true
INFERENCE_LOCAL_QWEN3_VL_EMBEDDING_MODEL_PATH=/data/models/qwen3-vl-embedding-2b
INFERENCE_LOCAL_QWEN3_VL_RERANKER_MODEL_PATH=/data/models/qwen3-vl-reranker-2b
# 纯视觉检索模式（管理页面会校验模型与索引就绪状态后再允许切换）。
LOCAL_RETRIEVAL_PIPELINE=qwen
INFERENCE_LOCAL_SIGLIP2_MODEL_PATH=/data/models/siglip2-so400m-patch16-512
# retrieval 模型由 ${INFERENCE_DATA_DIR}/retrieval/models 挂载到 /data/models；改以下配置后只需重新创建容器，无需重建镜像。
INFERENCE_LOCAL_DINOV3_REPO_ID=timm/vit_base_patch16_dinov3.lvd1689m
INFERENCE_LOCAL_DINOV3_MODEL_PATH=/data/models/vit-base-patch16-dinov3-lvd1689m
VISUAL_RECALL_TOPK=50
VISUAL_PATCH_TOPN=10
VISUAL_PATCH_MAX_TOKENS=256
VISUAL_MAXSIM_THRESHOLD=0.5
# 仅下载私有或 gated 模型时需要；默认公开版 DINOv3 无需配置。
HF_TOKEN=

# ─── Flower (Celery monitoring) ───────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=your_flower_password
